<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <Space
            android:layout_width="1dp"
            android:layout_height="24dp" />

        <Switch
            android:id="@+id/sw0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ignore_package_limit" />

        <Switch
            android:id="@+id/swLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/log_switch" />

        <EditText
            android:id="@+id/et0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/clipboard_capacity"
            android:inputType="number"
            android:singleLine="true" />

        <Switch
            android:id="@+id/swSyncAndroidClipboardCapacity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sync_android_clipboard_capacity" />

        <EditText
            android:id="@+id/et1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/clipboard_expire_time"
            android:inputType="number"
            android:singleLine="true" />

        <Button
            android:id="@+id/bt0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apply" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/runtime_status_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/refresh_status" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="@string/status_not_checked"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/restart_hint"
            android:textIsSelectable="true" />

        <Space
            android:layout_width="1dp"
            android:layout_height="24dp" />

    </LinearLayout>

</ScrollView>
